# VoxSwarm Environment Configuration
# Copy this file to .env and fill in your values

# ─── REQUIRED ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Model LLM (opsional) ─────────────────────────────────
# Model untuk agen diskusi (primary chain: gpt-oss-20b → gpt-oss-120b → qwen3.8-27b)
MODEL_AGENT=openai/gpt-oss-20b
# Model untuk analisis final (analysis chain: gpt-oss-120b → qwen3.8-27b)
MODEL_ANALYSIS=openai/gpt-oss-120b

# Model chain configuration untuk llm_guard (fallback otomatis saat rate limit)
MODEL_CHAIN_AGENT=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
MODEL_CHAIN_ANALYSIS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# ─── Token Budget (opsional) ──────────────────────────────
# Diturunkan agar total TPM aman di bawah 7K limit free tier
MAX_TOKENS_AGENT=500
MAX_TOKENS_RESPONSE=500
MAX_TOKENS_ANALYSIS=1200
MAX_TOKENS_SUMMARY=100
MAX_TOKENS_SENTIMENT=300

# ─── LLM Guard Rate Limit (opsional) ──────────────────────
# Token per menit per model (margin di bawah 8K free tier)
TPM_LIMIT=7000

# ─── Rate Limit API (opsional) ────────────────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=8
MAX_TOPIC_LENGTH=300

# ─── Simulasi Timing (opsional) ─────────────────────────────
AGENT_CALL_DELAY=3.0
ROUND_DELAY=3.0

# ─── Sentiment Mode (opsional) ───────────────────────────
# "ml" (deterministik), "llm" (akurat), atau "inline" (hemat token)
SENTIMENT_MODE=llm

# ─── Cache RSS (opsional) ─────────────────────────────────
CONTEXT_CACHE_TTL_MINUTES=30
CONTEXT_CACHE_MAX_ENTRIES=100

# ─── CORS (opsional) ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── ML Pipeline (opsional) ───────────────────────────────
ML_MIN_SAMPLES=5
ML_MAX_HISTORY=500

# ─── Free Tier Mode (opsional) ────────────────────────────
# true = hemat token (max 4 agen, max 2 ronde, no GraphRAG, no final LLM analysis)
FREE_TIER_MODE=false